# Copy to .env (root) for the API, and to apps/web/.env.local for the web app.

# ---- API (apps/api) ----
PORT=8080
# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL=postgres://seatlayout:seatlayout@localhost:5432/seatlayout?sslmode=disable
# Comma-separated allowed CORS origins for the API (the web dev server).
CORS_ORIGINS=http://localhost:3000
# Auth is scaffolded but off by default. Set to true once an Authenticator is wired.
AUTH_ENABLED=false
# Simple token-bucket rate limit: requests per second per client IP (0 = disabled).
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# ---- Web (apps/web/.env.local) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
